<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same as backup_rules.xml, for cloud backup and device transfer alike. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="kk_prefs.xml" />
        <exclude domain="file" path="clipboard.txt" />
        <exclude domain="file" path="clips/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="kk_prefs.xml" />
        <exclude domain="file" path="clipboard.txt" />
        <exclude domain="file" path="clips/" />
    </device-transfer>
</data-extraction-rules>
